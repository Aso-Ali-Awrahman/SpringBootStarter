<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="05-add-status-to-product-table" author="aso.ali"
               logicalFilePath="05-add-status-to-product-table.xml">

        <addColumn schemaName="store" tableName="product">
            <column name="status" type="varchar(20)"/>
        </addColumn>

        <sql>
            UPDATE store.product SET status = 'ACTIVE' WHERE status IS NULL;
        </sql>

    </changeSet>
</databaseChangeLog>