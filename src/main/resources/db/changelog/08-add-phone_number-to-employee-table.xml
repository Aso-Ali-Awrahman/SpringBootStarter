<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="08-add-phone_number-to-employee-table" author="aso.ali"
               logicalFilePath="08-add-phone_number-to-employee-table.xml">

        <addColumn schemaName="user_management" tableName="employee">
            <column name="phone_number" type="varchar(11)">
                <constraints nullable="false" unique="true"/>
            </column>
        </addColumn>

    </changeSet>
</databaseChangeLog>